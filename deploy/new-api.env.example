# Copy to /etc/new-api/new-api.env (chown root:new-api && chmod 640)
HOST=127.0.0.1
PORT=3000
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN

# Host PostgreSQL (dedicated role and database)
SQL_DSN=postgresql://new_api:CHANGE_ME@127.0.0.1:5432/new_api?sslmode=disable

# Single-node without Redis
MEMORY_CACHE_ENABLED=true
BATCH_UPDATE_ENABLED=true
ERROR_LOG_ENABLED=true

# HTTPS & reverse proxy security
SESSION_SECRET=CHANGE_ME_32_BYTE_HEX
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://token.truestlens.com
TRUSTED_PROXIES=127.0.0.1

# Streaming timeout (seconds)
STREAMING_TIMEOUT=300
